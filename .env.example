# ─── CheckData ───────────────────────────────────────────
CHECKDATA_TOKEN=unicontroller-api-completa

# ─── Telegram ────────────────────────────────────────────
# Obtenha em https://t.me/BotFather com /newbot
TELEGRAM_BOT_TOKEN=seu_token_aqui

# ─── Segurança da API REST ────────────────────────────────
# Chave para acessar as rotas /consulta/{tipo}
API_SECRET=troque-por-uma-chave-segura

# ─── Railway / Deploy ─────────────────────────────────────
# URL pública do seu app no Railway (necessário para webhook)
# Deixe vazio para usar polling (desenvolvimento local)
WEBHOOK_URL=https://seu-app.up.railway.app

# ─── Porta (Railway define automaticamente) ───────────────
PORT=8000
